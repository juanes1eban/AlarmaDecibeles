<Window x:Class="AlarmaDecibeles.MicWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Fuente de audio" Width="340" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False" Background="#1E2A33">
    <StackPanel Margin="16">
        <TextBlock Text="Elige el micrófono:" Foreground="#C8D2D8" FontSize="14" Margin="0,0,0,8"/>
        <ListBox x:Name="MicList" Height="190" Background="#11181E" Foreground="#C8D2D8"
                 BorderBrush="#2C3A44" BorderThickness="2" FontSize="14"
                 MouseDoubleClick="SaveButton_Click">
            <ListBox.ItemContainerStyle>
                <Style TargetType="ListBoxItem">
                    <Setter Property="Padding" Value="6,3"/>
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="ListBoxItem">
                                <Border x:Name="Bg" Background="Transparent" Padding="{TemplateBinding Padding}">
                                    <ContentPresenter/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="Bg" Property="Background" Value="#24323C"/>
                                    </Trigger>
                                    <Trigger Property="IsSelected" Value="True">
                                        <Setter TargetName="Bg" Property="Background" Value="#2E4A42"/>
                                        <Setter Property="Foreground" Value="#7FD6A8"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
            </ListBox.ItemContainerStyle>
        </ListBox>
        <TextBlock x:Name="WindowsDefaultText" Foreground="#7F9AA8" FontSize="12" TextWrapping="Wrap"
                   Margin="0,8,0,0"/>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Style="{StaticResource PanelButton}" Content="Cancelar" IsCancel="True" Margin="0,0,8,0"/>
            <Button Style="{StaticResource PanelButton}" Content="Guardar" IsDefault="True"
                    Foreground="#7FD6A8" BorderBrush="#7FD6A8" Click="SaveButton_Click"/>
        </StackPanel>
    </StackPanel>
</Window>
