<Window x:Class="AlarmaDecibeles.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Alarma Decibeles" SizeToContent="WidthAndHeight" ResizeMode="CanMinimize"
        Background="#1E2A33">
    <Window.Resources>
        <Style x:Key="TrackButton" TargetType="RepeatButton">
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RepeatButton">
                        <Rectangle Fill="Transparent"/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="Fader" TargetType="Slider">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Slider">
                        <Grid Width="60">
                            <Border Width="24" CornerRadius="12" Background="#7FD6A8"
                                    BorderBrush="#2C3A44" BorderThickness="2" HorizontalAlignment="Center"/>
                            <TextBlock Text="Nivel Rojo" Foreground="#1E2A33" FontWeight="Bold" FontSize="14"
                                       HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,12">
                                <TextBlock.LayoutTransform>
                                    <RotateTransform Angle="-90"/>
                                </TextBlock.LayoutTransform>
                            </TextBlock>
                            <Track x:Name="PART_Track" Orientation="Vertical">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Style="{StaticResource TrackButton}" Command="Slider.DecreaseLarge"/>
                                </Track.DecreaseRepeatButton>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Style="{StaticResource TrackButton}" Command="Slider.IncreaseLarge"/>
                                </Track.IncreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb>
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="Thumb">
                                                <Grid Width="50" Height="50">
                                                    <Ellipse Stroke="#9FB0BA" StrokeThickness="2">
                                                        <Ellipse.Fill>
                                                            <RadialGradientBrush>
                                                                <GradientStop Color="#C8D2D8" Offset="0"/>
                                                                <GradientStop Color="#5E6C75" Offset="1"/>
                                                            </RadialGradientBrush>
                                                        </Ellipse.Fill>
                                                    </Ellipse>
                                                    <TextBlock Foreground="White" FontWeight="Bold" FontSize="12"
                                                               HorizontalAlignment="Center" VerticalAlignment="Center"
                                                               Text="{Binding Value, RelativeSource={RelativeSource AncestorType=Slider}, StringFormat={}{0:0}dB}"/>
                                                </Grid>
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <StackPanel Orientation="Horizontal" Margin="16">
        <Border Background="#11181E" BorderBrush="#2C3A44" BorderThickness="2" Padding="4" Height="300">
            <UniformGrid x:Name="Meter" Columns="2" Width="44"/>
        </Border>

        <Slider x:Name="ThresholdSlider" Style="{StaticResource Fader}" Height="300" Margin="12,0"
                Minimum="-60" Maximum="0" Value="-20" LargeChange="2"
                ValueChanged="ThresholdSlider_ValueChanged"/>

        <DockPanel Height="300">
            <Button x:Name="MicButton" DockPanel.Dock="Top" Style="{StaticResource PanelButton}"
                    Content="🎤 Micrófono" Click="MicButton_Click"
                    ToolTip="" ToolTipOpening="MicButton_ToolTipOpening"/>
            <TextBlock x:Name="VersionText" DockPanel.Dock="Top" Foreground="#5E6C75" FontSize="11"
                       HorizontalAlignment="Center" Margin="0,6,0,0"/>
            <Button x:Name="ToggleButton" DockPanel.Dock="Bottom" Style="{StaticResource PanelButton}"
                    Content="▶ Iniciar" Click="ToggleButton_Click"/>
            <TextBlock x:Name="LevelText" DockPanel.Dock="Bottom" Text="--- dB" Foreground="#7F9AA8" FontSize="14"
                       HorizontalAlignment="Center" Margin="0,0,0,12"/>
            <Border/>
        </DockPanel>
    </StackPanel>
</Window>
